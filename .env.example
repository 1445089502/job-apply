# 应用
APP_NAME=job-apply
APP_ENV=dev
DEBUG=true

# 数据库：MVP 用 SQLite，后续切 MySQL
DATABASE_URL=sqlite:///./data/job_apply.db
# DATABASE_URL=mysql+pymysql://root:root123@127.0.0.1:3306/job_apply?charset=utf8mb4

# 安全（生产必须改）
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256

# AI（MVP 可后置，留空则不启用）
EMBEDDING_MODEL=bge-m3
LLM_PROVIDER=
OLLAMA_BASE_URL=http://127.0.0.1:11434
